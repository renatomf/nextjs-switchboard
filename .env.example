# Every variable this project reads, and where each one is needed.
#
# Copy to .env.local and fill in. Nothing here carries a value: this file is
# committed, .env.local is not.
#
# Three different things read these, and they do not overlap:
#   app     the Next app — locally, and on whatever host serves it
#   worker  the Trigger.dev worker, whose variables live in their dashboard
#   tests   the Playwright suite, locally and in CI

# --- Database ---------------------------------------------------------------
# app, worker and migrations.
#
# Two URLs, and the difference is not cosmetic: the pooled one has "-pooler" in
# its host and is what the app uses; migrations need the direct one, because
# PgBouncer runs in transaction mode and has no session state for them.
#
# On Vercel both are set by the Neon integration, per deployment, and a preview
# gets its own database branch. Do not set them there by hand — they belong to
# the integration and would be overwritten.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Clerk ------------------------------------------------------------------
# app. Without the first two, every dynamic route answers 500: the middleware
# runs before any page and throws.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=

# --- Liveblocks -------------------------------------------------------------
# app. The canvas authenticates through /api/liveblocks/auth, so the secret is
# all there is — this setup has no public key in the browser.
LIVEBLOCKS_SECRET_KEY=

# --- Trigger.dev ------------------------------------------------------------
# app, to start runs and mint the realtime token the canvas subscribes with.
# Its prefix also decides which environment a schedule belongs to: a tr_dev_
# key puts schedules in development, a tr_prod_ key in production.
TRIGGER_SECRET_KEY=

# --- Browserbase ------------------------------------------------------------
# app, for the replay route, which proxies the recording because fetching it
# needs the secret key. Also worker, which opens the sessions.
BROWSERBASE_API_KEY=

# --- The credentials vault --------------------------------------------------
# app. 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it loses every sealed secret — there is no recovery, only rotating
# each webhook (ADR 0011).
CREDENTIALS_KEY=

# --- Sentry -----------------------------------------------------------------
# The first two at runtime, the third only at build time, to upload source maps.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Worker only ------------------------------------------------------------
# Read by tasks running on Trigger.dev, never by the app. Set them per
# environment in the Trigger.dev dashboard; locally the CLI reads this file and
# those values win over the dashboard's.
RESEND_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
# "provider/model". Unset means google/gemini-3.8-flash, which is free — the
# default is deliberately a model that costs nothing, so a forgotten variable
# cannot start spending. An ollama/* model runs on this machine, so it works
# with `trigger dev` and nowhere else — setting it on a host makes every run
# fail with ECONNREFUSED. An anthropic/* model needs CLAUDE_API_KEY and paid
# credit.
STAGEHAND_MODEL=

# --- Tests only -------------------------------------------------------------
# The suite signs in as this user and switches to this organization before
# anything else. Point it at one whose data you are willing to lose: the tests
# create and delete workflows in it.
E2E_CLERK_USER_EMAIL=
E2E_CLERK_ORG_NAME=
# Runs the suite against a deployment instead of starting a dev server, which
# is how it runs against a preview.
E2E_BASE_URL=
